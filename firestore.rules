rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownsExisting() {
      return request.auth != null && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow get, create, update, delete: if isUser(uid);
    }

    match /budgets/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /expenses/{id} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /userProgress/{uid} {
      allow get: if isUser(uid);
      allow create, update: if isUser(uid) && ownsIncoming();
    }

    match /quests/{id} {
      allow list: if ownsExisting();
      // The creation transaction reads its own deterministic ID before the quest exists.
      allow get: if ownsExisting() || (request.auth != null
        && resource == null
        && request.auth.uid.matches('^[A-Za-z0-9_-]+$')
        && id.matches('^v2-(daily|weekly|monthly)-[0-9]{4}-[0-9]{2}-[0-9]{2}-' + request.auth.uid + '$'));
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /bankConnections/{uid} {
      allow get, delete: if isUser(uid);
    }
  }
}
